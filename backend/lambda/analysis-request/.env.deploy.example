# ./deploy.sh 가 읽는 값. 이 파일을 .env.deploy 로 복사해서 채우세요 (.env.deploy 는 커밋되지 않음)
COGNITO_USER_POOL_ID=ap-northeast-2_egqvLgHX0
COGNITO_CLIENT_ID=4e5k8vs12cuudmka7m4mnjdkum
APP_BASE_URL=https://app.spirit-lab.me

# Slack: 워크스페이스 → 앱 → Incoming Webhooks → 채널 선택 후 발급된 URL
SLACK_WEBHOOK_URL=

# SES: 검증된 발신 주소 (예: noreply@spirit-lab.me). 비우면 이메일 발송 생략
SES_FROM_EMAIL=
SES_REPLY_TO=
SERVICE_NAME=Sayme
